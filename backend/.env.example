# Server configuration
PORT=8080
APP_ENV=development

# Security
PERIKSA_SECRET=periksa-development-secret-key-min16chars
WEB_ORIGIN=http://localhost:3000
# Optional comma-separated proxy IPs/CIDRs. Leave empty unless running behind a trusted proxy.
TRUSTED_PROXIES=

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/periksa?sslmode=disable

# Cache & Rate Limiting (Redis). Empty disables shared cache and uses per-process memory.
REDIS_URL=redis://localhost:6379/0

# AI Engine Service
AI_ENGINE_GRPC_ADDR=localhost:50051
AI_ENGINE_GRPC_TLS=false
# Optional REST fallback endpoint for audit requests.
AI_ENGINE_URL=http://localhost:8000
AI_API_KEY=periksa-ai-secret-key-development

# File storage
STORAGE_DIR=./data/files
