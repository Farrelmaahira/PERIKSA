# Server configuration
PORT=8080
APP_ENV=development

# Security
PERIKSA_SECRET=periksa-development-secret-key-min16chars

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/periksa?sslmode=disable

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379/0

# AI Engine Service
AI_ENGINE_GRPC_ADDR=localhost:50051

# File storage
STORAGE_DIR=./data/files
