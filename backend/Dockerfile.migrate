FROM golang:1.26-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /migrate ./cmd/migrate

FROM alpine:3.20
WORKDIR /app
COPY --from=builder /migrate /app/migrate
COPY scripts/PERIKSA.sql /app/PERIKSA.sql
COPY scripts/seed_demo.sql /app/seed_demo.sql
ENTRYPOINT ["/app/migrate", "-file", "/app/PERIKSA.sql"]
