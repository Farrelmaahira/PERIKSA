# Root Environment Configuration for Docker Compose
APP_ENV=development
PERIKSA_SECRET=periksa-development-secret-key-min16chars
PORT=8080
DATABASE_URL=postgres://postgres:postgres@postgres:5432/periksa?sslmode=disable
REDIS_URL=redis://redis:6379/0
AI_ENGINE_GRPC_ADDR=ai-engine:50051
AI_ENGINE_GRPC_TLS=false
AI_ENGINE_URL=http://ai-engine:8000
STORAGE_DIR=/data/files
WEB_ORIGIN=http://localhost:3000
TRUSTED_PROXIES=

# AI Engine (isi salah satu atau keduanya: Gemini / Groq)
AI_API_KEY=periksa-ai-secret-key-development
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDERS=gemini:gemini-3-flash-preview,groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash
AI_PROVIDER_TIMEOUT=6

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
