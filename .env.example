# Root Environment Configuration for Docker Compose
APP_ENV=development
PERIKSA_SECRET=periksa-development-secret-key-min16chars
PORT=8080
DATABASE_URL=postgres://postgres:postgres@postgres:5432/periksa?sslmode=disable
REDIS_URL=redis://redis:6379/0
AI_ENGINE_GRPC_ADDR=ai-engine:50051
STORAGE_DIR=/data/files

# AI Engine
AI_API_KEY=periksa-ai-secret-key-development
GEMINI_API_KEY=

# Frontend (bisa diarahkan ke localhost:8080 atau URL production Azure)
NEXT_PUBLIC_API_URL=https://periksa-api.azurewebsites.net/api/v1
