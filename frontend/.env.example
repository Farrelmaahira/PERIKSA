# Public API endpoint consumed by the browser.
# Local Docker Compose:
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Production example:
# NEXT_PUBLIC_API_URL=https://periksa-backend.azurewebsites.net/api/v1

# Canonical URL used for metadata, sitemap, and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 1 = demo mode without a backend; 0 or unset = always use the backend.
NEXT_PUBLIC_DUMMY=0

# Server-side bridge to ai-engine for contract summaries.
# Do not prefix these with NEXT_PUBLIC_: the key must never reach the browser.
AI_ENGINE_URL=http://localhost:8000
AI_API_KEY=periksa-ai-secret-key-development
